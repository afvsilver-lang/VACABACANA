# Copie este archivo a ".env" (mismo directorio que docker-compose.yml) y
# cambie los valores. Sin este archivo, docker compose usa los valores por
# defecto definidos en docker-compose.yml.

# Clave secreta usada para firmar los tokens de sesion (JWT). Use una cadena
# larga y aleatoria en un entorno real.
JWT_SECRET_KEY=cambia-esta-clave-en-produccion

# Credenciales del usuario administrador que se crea automaticamente la
# primera vez que arranca el backend (solo si no existe ningun usuario aun).
ADMIN_USERNAME=andres
ADMIN_PASSWORD=vacas123456789

# Clave de la API de OpenAI para el bot del dashboard. Se obtiene en
# https://platform.openai.com/api-keys . Sin esta clave el boton del bot
# muestra un mensaje de error.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
