# Imagen de produccion para Render: compila con nitro (preset node-server) y
# sirve el resultado con Node. El Dockerfile normal se sigue usando en local
# con docker compose (modo desarrollo con vite dev).
FROM oven/bun:1 AS build

WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY . .

# Las variables VITE_* se incrustan al compilar, no en tiempo de ejecucion: si
# se cambia la URL del backend hay que volver a construir la imagen.
ARG VITE_API_URL=https://olinda-backend.onrender.com
ENV VITE_API_URL=$VITE_API_URL
ENV NITRO_PRESET=node-server

RUN bun run build

FROM node:22-slim AS runtime

WORKDIR /app

COPY --from=build /app/.output ./.output

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

CMD ["node", ".output/server/index.mjs"]
