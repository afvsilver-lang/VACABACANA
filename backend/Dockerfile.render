# Imagen de produccion para Render. El Dockerfile normal se sigue usando en
# local con docker compose (incluye --reload para desarrollo).
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements.txt .
RUN pip install --no-cache-dir --default-timeout=120 -r requirements.txt

COPY . .

# Render inyecta PORT en tiempo de ejecucion; el valor por defecto sirve en local.
ENV PORT=8000
EXPOSE 8000

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT}"]
